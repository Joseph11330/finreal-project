generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HR_OFFICER
  DEPARTMENT_HEAD
  STAFF
}

enum AccountStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  DIVORCED
}

enum EmploymentType {
  REGULAR
  PROBATIONARY
  CONTRACTUAL
  PART_TIME
}

model Branch {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique
  address     String?
  departments Department[]
  users       User[]
  createdAt   DateTime     @default(now())
}

model Department {
  id        String   @id @default(cuid())
  name      String
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  users     User[]
  createdAt DateTime @default(now())

  @@unique([branchId, name])
}

enum ApplicationType {
  LATE_ARRIVAL_APPEAL
  LEAVE_REQUEST
  OVERTIME_REQUEST
}

enum ApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// A submitted employee form (e.g. a Late Arrival Appeal) routed to a
/// supervisor for approval. Rejection always requires a written reason,
/// which is stored for the audit trail shown on the review document.
model Application {
  id           String            @id @default(cuid())
  documentId   String            @unique // e.g. "LAA-2024-0524-001"
  type         ApplicationType
  status       ApplicationStatus @default(PENDING_REVIEW)

  submittedById String
  submittedBy   User   @relation("ApplicationsSubmitted", fields: [submittedById], references: [id])

  submissionDate DateTime @default(now())

  // Late Arrival Appeal specifics
  appealType          String? // e.g. "Retroactive Appeal"
  dateOfIncident       DateTime?
  expectedArrivalTime  String? // "09:00 AM"
  actualArrivalTime    String? // "09:42 AM"
  totalDelayMinutes    Int?
  incidentNotes        String?

  reviewedById String?
  reviewedBy   User?     @relation("ApplicationsReviewed", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum CalendarEntryType {
  EVENT
  HOLIDAY
}

/// A dated item shown on the Event Calendar and October Schedule panels.
/// Holidays are typically seeded/admin-managed; Events can be created from
/// the "Add Event" option in the announcement composer.
model CalendarEntry {
  id          String            @id @default(cuid())
  title       String
  type        CalendarEntryType
  date        DateTime
  time        String? // display string, e.g. "2:00 PM"
  location    String?
  description String?
  pinned      Boolean           @default(false)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkedAnnouncements Announcement[]

  @@index([date])
}

/// A broadcast post on the Dashboard's "Publish Announcement" feed. Can
/// optionally be pinned to the "Pinned Important" panel and can reference a
/// linked CalendarEntry when it was published together with an event.
model Announcement {
  id      String @id @default(cuid())
  subject String
  body    String

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  pinned              Boolean  @default(false)
  attachmentName      String?
  attachmentSizeLabel String? // e.g. "2.4 MB"

  linkedEventId String?
  linkedEvent   CalendarEntry? @relation(fields: [linkedEventId], references: [id])

  allowReactions Boolean @default(true)
  allowComments  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned])
  @@index([createdAt])
}

/// Central user record. Registration is created as PENDING_REVIEW and must be
/// activated by an existing admin before the account can sign in, matching the
/// "Authorized Access Only" posture of the Admin Portal.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(STAFF)
  status       AccountStatus @default(PENDING_REVIEW)

  // Step 2 - Personal Information
  firstName     String
  middleName    String?
  lastName      String
  dateOfBirth   DateTime
  gender        Gender
  civilStatus   CivilStatus
  nationality   String      @default("Filipino")
  contactNumber String
  address       String

  // Step 3 - Employment Details
  employeeId     String?         @unique
  position       String
  employmentType EmploymentType
  dateHired      DateTime?
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id])
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id])

  // Step 4 - Statutory / Government IDs (PH)
  sssNumber        String?
  philHealthNumber String?
  pagIbigNumber    String?
  tinNumber        String?

  // Step 5 - Emergency Contact
  emergencyContactName     String
  emergencyContactPhone    String
  emergencyContactAddress  String?
  emergencyContactRelation String

  // Step 6 - Legal Consent (RA 10173)
  dataPrivacyConsent Boolean   @default(false)
  termsConsent       Boolean   @default(false)
  consentedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationsSubmitted Application[] @relation("ApplicationsSubmitted")
  applicationsReviewed  Application[] @relation("ApplicationsReviewed")
  announcements         Announcement[]
  calendarEntries       CalendarEntry[]

  @@index([status])
}
